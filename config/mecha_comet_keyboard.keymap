#include "common/omit.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        fn_td: fn_td {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Function Tap Dance";
            #binding-cells = <0>;
            bindings = <&sl 1>, <&tog 1>;

            tapping-term-ms = <300>;
        };

        fn_key: fn_key {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Function Key";
            bindings = <&mo>, <&fn_td>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };

        num_td: num_td {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Number Tap Dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&sl 2>, <&tog 2>;
        };

        num_key: num_key {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Number Key";
            bindings = <&mo>, <&num_td>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };

        shift_td: shift_td {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&caps_word>;

            tapping-term-ms = <300>;
        };

        shift_key: shift_key {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Shift Key";
            bindings = <&kp>, <&shift_td>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_middle_click {
            bindings = <&mkp MCLK>;
            key-positions = <1 2>;
            timeout-ms = <50>;
            layers = <0>;
        };
    };

    macros {
        emoji: emoji {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>,
                       <&macro_tap &kp PERIOD>,
                       <&macro_release &kp LGUI>,
                       <&macro_tap &kp SPACE>;
            display-name = "Emoji";
            wait-ms = <30>;
        };
    };

    /* dts-format off */

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp ESC                  &mkp LCLK    &mkp RCLK  &kp RIGHT  &kp UP     &kp LEFT  &kp LGUI    &kp DOWN
&kp Q                    &kp W        &kp E      &kp R      &kp T      &kp Y     &kp U       &kp I        &kp O         &kp P
&kp A                    &kp S        &kp D      &kp F      &kp G      &kp H     &kp J       &kp K        &kp L         &kp BSPC
&shift_key LEFT_SHIFT 0  &kp Z        &kp X      &kp C      &kp V      &kp B     &kp N       &kp M        &kp RETURN
&sk LEFT_CONTROL         &fn_key 1 0  &kp TAB    &kp COMMA  &kp SPACE  &kp DOT   &sk LALT    &fn_key 1 0  &num_key 2 0
            >;
        };

        function_layer {
            display-name = "Function";
            bindings = <
&rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &trans          &rgb_ug RGB_HUI  &rgb_ug RGB_BRI   &rgb_ug RGB_HUD    &rgb_ug RGB_TOG    &rgb_ug RGB_BRD
&kp EXCLAMATION  &kp AT_SIGN      &kp HASH        &kp DOLLAR       &kp PERCENT       &kp CARET          &kp AMPERSAND      &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp TILDE        &kp GRAVE        &kp COLON       &kp SEMICOLON    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp UNDERSCORE     &trans            &kp BACKSLASH         &kp DELETE
&rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LESS_THAN     &kp GREATER_THAN   &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE  &sys_reset
&studio_unlock   &trans           &trans          &kp SLASH        &trans            &kp QUESTION       &emoji             &trans            &bootloader
            >;
        };

        number_layer {
            display-name = "Number";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans
&kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7        &kp N8       &kp N9     &kp N0
&trans  &trans  &trans  &trans  &trans  &trans  &kp KP_MINUS  &kp KP_PLUS  &kp EQUAL  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans       &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};

/* dts-format on */

&ext_power {
    status = "disabled";
};

&sl {
    release-after-ms = <5000>;
};

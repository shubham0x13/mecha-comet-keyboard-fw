 #define ADS1X1X_CONFIG_MUX(x) ((x) << 12)
 #define ADS1X1X_CONFIG_PGA(x) ((x) << 9)
@@ -144,16 +152,27 @@ struct ads1x1x_config {
 	bool pga;
 };
 
+struct ads1x1x_channel {
+	/* Configuration register of the channel, without the OS bit */
+	uint16_t config;

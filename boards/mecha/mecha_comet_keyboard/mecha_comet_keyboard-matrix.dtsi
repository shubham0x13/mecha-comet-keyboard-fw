/*
 * 5 rows x 10 columns, 46 keys. Rows are driven low one at a time, columns are
 * read with pull-ups. Each switch has a diode from the column to the row.
 *
 * Row 4 (the PTD1 pin, drawn as "PTD0_raw_5" on the schematic) holds the three
 * dome switches (columns 0 to 2) and the five switches of the 5-way joystick,
 * which share the row line as their common contact:
 *   col 4 (PTC2) joystick pin 6      col 7 (PTC5) joystick pin 2
 *   col 5 (PTC3) joystick pin 4      col 8 (PTC6) joystick pin 3
 *   col 6 (PTC4) joystick pin 1
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &layout0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "row2col";
        row-gpios = <&gpiob 0 GPIO_ACTIVE_LOW>,
                    <&gpiob 1 GPIO_ACTIVE_LOW>,
                    <&gpiob 2 GPIO_ACTIVE_LOW>,
                    <&gpiob 3 GPIO_ACTIVE_LOW>,
                    <&gpiod 1 GPIO_ACTIVE_LOW>;
        col-gpios = <&gpiob 16 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                    <&gpiob 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                    <&gpioc 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                    <&gpioc 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                    <&gpioc 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                    <&gpioc 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                    <&gpioc 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                    <&gpioc 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                    <&gpioc 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                    <&gpioc 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    transform0: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <5>;
        columns = <10>;
        map = <
               /* Row 4 (Electrically Row 5): Dome switches & Joystick at the top */
               RC(4,0) RC(4,1) RC(4,2) RC(4,4) RC(4,5) RC(4,6) RC(4,7) RC(4,8)

               /* Rows 0 to 3: Main keyboard rows below them */
               RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
               RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
               RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8)
               RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8)>;
    };
};

&layout0 {
    transform = <&transform0>;
};

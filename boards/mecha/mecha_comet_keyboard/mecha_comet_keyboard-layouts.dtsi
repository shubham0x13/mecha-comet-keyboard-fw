/*
 * The 46 keys, in the order of the matrix transform: x and y are in 1/100 of a
 * key. The same layout is in config/info.json and physical-layout/.
 */

#include <physical_layouts.dtsi>

/ {
    layout0: physical_layout0 {
        compatible = "zmk,physical-layout";
        display-name = "Default";

        /* Positions 0 to 7, row 4 of the matrix: the dome switches and the joystick. */
        keys = <&key_physical_attrs 100 100 0 100 0 0 0>,  /* RC(4,0) - Dome 1 */
               <&key_physical_attrs 100 100 150 100 0 0 0>,  /* RC(4,1) - Dome 2 */
               <&key_physical_attrs 100 100 550 100 0 0 0>,  /* RC(4,2) - Dome 3 */
               <&key_physical_attrs 100 100 900 100 0 0 0>,  /* RC(4,4) - Joystick Pin 6 */
               <&key_physical_attrs 100 100 800 0 0 0 0>,  /* RC(4,5) - Joystick Pin 4 */
               <&key_physical_attrs 100 100 700 100 0 0 0>,  /* RC(4,6) - Joystick Pin 1 */
               <&key_physical_attrs 100 100 800 100 0 0 0>,  /* RC(4,7) - Joystick Pin 2 */
               <&key_physical_attrs 100 100 800 200 0 0 0>,  /* RC(4,8) - Joystick Pin 3 */

               /* Positions 8 to 45, rows 0 to 3 of the matrix. */
               <&key_physical_attrs 100 100 0 350 0 0 0>,
               <&key_physical_attrs 100 100 100 350 0 0 0>,
               <&key_physical_attrs 100 100 200 350 0 0 0>,
               <&key_physical_attrs 100 100 300 350 0 0 0>,
               <&key_physical_attrs 100 100 400 350 0 0 0>,
               <&key_physical_attrs 100 100 500 350 0 0 0>,
               <&key_physical_attrs 100 100 600 350 0 0 0>,
               <&key_physical_attrs 100 100 700 350 0 0 0>,
               <&key_physical_attrs 100 100 800 350 0 0 0>,
               <&key_physical_attrs 100 100 900 350 0 0 0>,
               <&key_physical_attrs 100 100 0 450 0 0 0>,
               <&key_physical_attrs 100 100 100 450 0 0 0>,
               <&key_physical_attrs 100 100 200 450 0 0 0>,
               <&key_physical_attrs 100 100 300 450 0 0 0>,
               <&key_physical_attrs 100 100 400 450 0 0 0>,
               <&key_physical_attrs 100 100 500 450 0 0 0>,
               <&key_physical_attrs 100 100 600 450 0 0 0>,
               <&key_physical_attrs 100 100 700 450 0 0 0>,
               <&key_physical_attrs 100 100 800 450 0 0 0>,
               <&key_physical_attrs 100 100 900 450 0 0 0>,
               <&key_physical_attrs 150 100 0 550 0 0 0>,
               <&key_physical_attrs 100 100 150 550 0 0 0>,
               <&key_physical_attrs 100 100 250 550 0 0 0>,
               <&key_physical_attrs 100 100 350 550 0 0 0>,
               <&key_physical_attrs 100 100 450 550 0 0 0>,
               <&key_physical_attrs 100 100 550 550 0 0 0>,
               <&key_physical_attrs 100 100 650 550 0 0 0>,
               <&key_physical_attrs 100 100 750 550 0 0 0>,
               <&key_physical_attrs 150 100 850 550 0 0 0>,
               <&key_physical_attrs 100 100 0 650 0 0 0>,
               <&key_physical_attrs 100 100 100 650 0 0 0>,
               <&key_physical_attrs 100 100 200 650 0 0 0>,
               <&key_physical_attrs 75 100 300 650 0 0 0>,
               <&key_physical_attrs 250 100 375 650 0 0 0>,
               <&key_physical_attrs 75 100 625 650 0 0 0>,
               <&key_physical_attrs 100 100 700 650 0 0 0>,
               <&key_physical_attrs 100 100 800 650 0 0 0>,
               <&key_physical_attrs 100 100 900 650 0 0 0>;
    };
};
